INSTALL PLUGIN toydb SONAME "ha_toydb.so";
DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (id INT NOT NULL AUTO_INCREMENT, name VARCHAR(50) NOT NULL, PRIMARY KEY (id)) ENGINE=TOYDB;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `name` varchar(50) NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=TOYDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
INSERT INTO t1 (name) VALUES ('Alice');
INSERT INTO t1 (name) VALUES ('Bob');
INSERT INTO t1 (name) VALUES ('Charlie');
SELECT * FROM t1;
id	name
1	Alice
2	Bob
3	Charlie
UPDATE t1 SET name = 'Alice_updated' WHERE id = 1;
SELECT * FROM t1;
id	name
1	Alice_updated
2	Bob
3	Charlie
DELETE FROM t1 WHERE id = 2;
SELECT * FROM t1;
id	name
1	Alice_updated
3	Charlie
DELETE FROM t1;
SELECT * FROM t1;
id	name
INSERT INTO t1 (name) VALUES ('Dave');
INSERT INTO t1 (name) VALUES ('Eve');
SELECT * FROM t1;
id	name
4	Dave
5	Eve
TRUNCATE TABLE t1;
SELECT * FROM t1;
id	name
INSERT INTO t1 (name) VALUES ('Frank');
SELECT * FROM t1;
id	name
1	Frank
INSERT INTO t1 (name) VALUES ('Grace');
UPDATE t1 SET id = 101, name = 'Frank_v2' WHERE id = 1;
SELECT * FROM t1;
id	name
2	Grace
101	Frank_v2
DROP TABLE t1;
SELECT * FROM t1;
ERROR 42S02: Table 'test.t1' doesn't exist
UNINSTALL PLUGIN toydb;
