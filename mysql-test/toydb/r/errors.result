INSTALL PLUGIN toydb SONAME "ha_toydb.so";
DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (
id INT NOT NULL,
name VARCHAR(50) NOT NULL,
PRIMARY KEY (id)
) ENGINE=TOYDB;
INSERT INTO t1 VALUES (NULL, 'test');
ERROR 23000: Column 'id' cannot be null
INSERT INTO t1 VALUES (1, NULL);
ERROR 23000: Column 'name' cannot be null
INSERT INTO t1 VALUES (1, 'test');
RENAME TABLE t1 TO t2;
ERROR 42000: This version of MySQL doesn't yet support 'ALTER TABLE'
SELECT * FROM t1;
id	name
1	test
DROP TABLE t1;
SELECT * FROM nonexistent_toydb_table;
ERROR 42S02: Table 'test.nonexistent_toydb_table' doesn't exist
CREATE TABLE t1 (
id INT NOT NULL,
PRIMARY KEY (id)
) ENGINE=TOYDB;
SELECT * FROM t1;
id
SELECT COUNT(*) FROM t1;
COUNT(*)
0
