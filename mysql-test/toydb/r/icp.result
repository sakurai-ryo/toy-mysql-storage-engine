INSTALL PLUGIN toydb SONAME "ha_toydb.so";
DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (
id INT NOT NULL,
category INT NOT NULL,
price INT NOT NULL,
name VARCHAR(50) NOT NULL,
PRIMARY KEY (id),
KEY idx_category (category)
) ENGINE=TOYDB;
INSERT INTO t1 VALUES (1, 10, 100, 'Alice');
INSERT INTO t1 VALUES (2, 10, 200, 'Bob');
INSERT INTO t1 VALUES (3, 10, 300, 'Charlie');
INSERT INTO t1 VALUES (4, 20, 100, 'Alice');
INSERT INTO t1 VALUES (5, 20, 200, 'Eve');
INSERT INTO t1 VALUES (6, 20, 300, 'Frank');
INSERT INTO t1 VALUES (7, 30, 100, 'Grace');
INSERT INTO t1 VALUES (8, 30, 200, 'Heidi');
SELECT * FROM t1 WHERE category = 10 ORDER BY id;
id	category	price	name
1	10	100	Alice
2	10	200	Bob
3	10	300	Charlie
SELECT * FROM t1 WHERE category = 10 AND name = 'Alice';
id	category	price	name
1	10	100	Alice
SELECT * FROM t1 WHERE category = 20 AND name = 'Alice';
id	category	price	name
4	20	100	Alice
SELECT * FROM t1 WHERE category = 10 AND price > 150 ORDER BY id;
id	category	price	name
2	10	200	Bob
3	10	300	Charlie
SELECT * FROM t1 WHERE category >= 10 AND name = 'Alice' ORDER BY id;
id	category	price	name
1	10	100	Alice
4	20	100	Alice
SELECT * FROM t1 WHERE category BETWEEN 10 AND 20 AND price = 200 ORDER BY id;
id	category	price	name
2	10	200	Bob
5	20	200	Eve
SELECT * FROM t1 WHERE category = 10 AND name = 'missing';
id	category	price	name
SELECT * FROM t1 WHERE id > 2 AND name = 'Alice' ORDER BY id;
id	category	price	name
4	20	100	Alice
SELECT * FROM t1 WHERE id BETWEEN 3 AND 6 AND price >= 200 ORDER BY id;
id	category	price	name
3	10	300	Charlie
5	20	200	Eve
6	20	300	Frank
DROP TABLE t1;
UNINSTALL PLUGIN toydb;
