# Basic CRUD operations for TOYDB storage engine

INSTALL PLUGIN toydb SONAME "ha_toydb.so";

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

# CREATE TABLE and INSERT
CREATE TABLE t1 (id INT NOT NULL AUTO_INCREMENT, name VARCHAR(50) NOT NULL, PRIMARY KEY (id)) ENGINE=TOYDB;
SHOW CREATE TABLE t1;

INSERT INTO t1 (name) VALUES ('Alice');
INSERT INTO t1 (name) VALUES ('Bob');
INSERT INTO t1 (name) VALUES ('Charlie');

SELECT * FROM t1;

# UPDATE
UPDATE t1 SET name = 'Alice_updated' WHERE id = 1;
SELECT * FROM t1;

# DELETE single row
DELETE FROM t1 WHERE id = 2;
SELECT * FROM t1;

# DELETE all rows
DELETE FROM t1;
SELECT * FROM t1;

# Re-insert after delete all
INSERT INTO t1 (name) VALUES ('Dave');
INSERT INTO t1 (name) VALUES ('Eve');
SELECT * FROM t1;

# TRUNCATE (uses HTON_CAN_RECREATE: delete_table + create)
TRUNCATE TABLE t1;
SELECT * FROM t1;

# Re-insert after truncate
INSERT INTO t1 (name) VALUES ('Frank');
SELECT * FROM t1;

# Multiple column update
INSERT INTO t1 (name) VALUES ('Grace');
UPDATE t1 SET id = 101, name = 'Frank_v2' WHERE id = 1;
SELECT * FROM t1;

# DROP TABLE
DROP TABLE t1;

# Verify table is gone
--error ER_NO_SUCH_TABLE
SELECT * FROM t1;

# Cleanup: restore server state
UNINSTALL PLUGIN toydb;
